# ===== Servidor =====
PORT=3000
# URL pública del sitio (se usa para las redirecciones de Stripe)
BASE_URL=http://localhost:3000

# ===== MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mafer

# ===== Administrador (se crea automáticamente la primera vez) =====
ADMIN_EMAIL=admin@mafer.com
ADMIN_PASSWORD=cambia-esta-clave
JWT_SECRET=pon-aqui-una-cadena-larga-y-aleatoria

# ===== Stripe (SOLO llaves de PRUEBA: sk_test_ / pk_test_) =====
# Consíguelas en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
# Opcional: secreto del webhook (stripe listen --forward-to localhost:3000/api/payments/webhook)
STRIPE_WEBHOOK_SECRET=

# ===== Tienda =====
CURRENCY=mxn
DELIVERY_FEE=45
FREE_DELIVERY_FROM=600
